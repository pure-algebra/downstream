import Hash.Sha3.Lengths
import Hash.Sha3.Digest
import Hash.Sha3.Bridge
import Hash.Sha3.Fast

/-! Public byte-oriented SHA3-512 API and its meaning in the FIPS 202 transcription. -/

namespace Hash.Sha3

/-- SHA3-512 of a byte string. Meaning: `sha3_512_spec`. Trust boundary: the FIPS 202
transcription and the Lean v4.33.1 kernel. -/
def sha3_512 (msg : ByteArray) : Digest 64 :=
  ⟨Fast.sha3_512 msg, Fast.size_sha3_512 msg⟩

/-- SHA3-512 of a string's UTF-8 bytes. -/
def sha3_512String (s : String) : Digest 64 := sha3_512 s.toUTF8

theorem sha3_512_impl (msg : ByteArray) :
    (sha3_512 msg).toList = Impl.sha3_512 msg.data.toList :=
  Fast.sha3_512_eq_impl msg

theorem sha3_512_spec (msg : ByteArray) :
    (sha3_512 msg).toList = Spec.sha3_512_bytes msg.data.toList := by
  rw [sha3_512_impl, Bridge.sha3_512_bridge]

theorem sha3_512_ofList (l : List UInt8) :
    (sha3_512 l.toByteArray).toList = Impl.sha3_512 l := by
  rw [sha3_512_impl, List.toList_data_toByteArray]

